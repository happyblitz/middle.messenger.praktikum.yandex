<div class="fixed-box modal-closed" data-js-profile>
  <div class="profile">
    <div class="profile__main">
      <div class="profile__header">
        {{> profile__header}}
        <h2 class="h2 profile__username">user</h2>
      </div>
      <div class="profile__data">
        {{#each profileFields}}
        <dl class="profile__data-container">
          <dt class="profile__data-term">{{label}}</dt>
          <dd class="profile__data-value">{{value}}</dd>
        </dl>
        {{/each}}
      </div>
      <div class="profile__controls">
        <button
          type="button"
          class="profile__controls-edit"
          data-js-profile-edit
        >
          Изменить данные
        </button>
        <button
          type="button"
          class="profile__controls-edit"
          data-js-profile-password
        >
          Изменить пароль
        </button>
        <a class="profile__controls-logout" href="/">Выйти</a>
      </div>
    </div>
    {{> profile__footer}}
  </div>
</div>
