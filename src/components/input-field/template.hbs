<label {{#if labelClassName}}class="{{#each labelClassName}}{{this}} {{/each}}"{{/if}}>
  {{#if label}}<span>{{label}}</span>{{/if}}
  <input
    type="{{#if type}}{{type}}{{else}}text{{/if}}"
    name="{{name}}"
    value="{{ value }}"
    {{#if id}}id="{{id}}"{{/if}}
    {{#if accept}}accept="{{accept}}"{{/if}}
    {{#if autocomplete}}autocomplete="{{autocomplete}}"{{/if}}
    {{#if placeholder}}placeholder="{{placeholder}}"{{/if}}
    {{#if className}}class="{{#each className}}{{this}} {{/each}}"{{/if}}
    ref="input"
  />
    {{{inputError}}}
</label>

