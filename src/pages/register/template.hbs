<div class="centered-box">
  <div class="centered-box__container">
    <div class="sign-up">
      <form action="" class="sign-up__form form" ref="form">
        <h1 class="h1">Регистрация</h1>
        <div class="form__fields">
          {{{emailInput}}} {{{loginInput}}} {{{passwordInput}}}
          {{{confirmPasswordInput}}} {{{firstNameInput}}} {{{secondNameInput}}}
          {{{phoneInput}}} {{{formError}}}
        </div>
        <div class="form__route">
          {{{submitButton}}}
          <a class="colored-link" href="{{sign_in}}">Войти</a>
        </div>
      </form>
    </div>
  </div>
</div>
