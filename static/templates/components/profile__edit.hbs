<div class="fixed-box modal-closed" data-js-profile-edit-modal>
  <div class="profile">
    <div class="profile__main">
      <div class="profile__header">
        <form action="" class="edit-logo__form">
          <input
            type="file"
            name="edit-logo-attach"
            class="edit-logo__form-attach visually-hidden"
            id="edit-logo-attach"
            accept="image/*"
            js-data-edit-logo-form-attach
          />
          <label for="edit-logo-attach">{{> profile__header}}</label>
        </form>
      </div>
      <form class="contents" action="">
        <div class="profile__data clear-input">
          {{#each profileFields}}
          <label class="profile__data-container">
            <span class="profile__data-term">{{label}}</span>
            <input
              type="text"
              name="{{label}}"
              value="{{value}}"
              class="profile__data-value"
            />
          </label>
          {{/each}}
        </div>
        <div class="profile__controls">
          <button
            type="button"
            class="profile__controls-edit"
            href=""
            data-js-modal-close-self
          >
            Сохранить
          </button>
        </div>
      </form>
    </div>
    {{> profile__footer}}
  </div>
</div>
