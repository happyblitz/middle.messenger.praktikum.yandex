<div class="messenger">
  <div
    class="messenger__inner {{#if activeChatCard}}channel-is-active{{/if}}"
    ref="messenger"
  >
    <aside class="messenger__aside">
      <header class="messenger__header static-header">
        {{{menuButton}}} {{{searchInput}}}
      </header>
      {{{newChannelButton}}}
      <div class="messenger__channels">
        <nav class="channels">
          <ul class="channels__list" ref="channelList"></ul>
        </nav>
      </div>
    </aside>
    <main class="messenger__main">{{{channelWindow}}}</main>
  </div>
  {{{newChannelModal}}}
</div>
