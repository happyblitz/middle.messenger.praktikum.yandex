{{#each messages}}
<div class="channel__message">
  <img
    class="channel__message-logo avatar"
    src="{{avatar}}"
    alt="Аватар чата"
  />
  <div class="channel__message-container">
    <div class="channel__message-message">{{message}}</div>
    {{#if image}}
    <div class="channel__message-image">
      <img src="{{image}}" alt="{{imageDesc}}" />
    </div>
    {{/if}}
  </div>
</div>
{{/each}}
