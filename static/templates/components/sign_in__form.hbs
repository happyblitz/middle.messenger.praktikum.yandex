<div class="sign-in">
  <form action="" class="sign-in__form form">
    <h1 class="h1">Войти</h1>
    <div class="form__fields">
      <input
        type="text"
        name="login"
        placeholder="ваш логин"
        value="{{ login }}"
        autocomplete="username"
        data-js-login
      />
      <input
        type="password"
        name="password"
        placeholder="ваш пароль"
        value="{{ password }}"
        autocomplete="current-password"
        data-js-password
      />
      {{> form_error }}
    </div>
    <div class="form__route">
      <button
        type="button"
        class="button-primary colored-border"
        {{
        button_disabled
        }}
        data-js-submit-button
      >
        Авторизоваться
      </button>
      <a class="colored-link" href="/register">Нет аккаунта</a>
    </div>
  </form>
</div>
