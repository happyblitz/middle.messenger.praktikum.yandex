<div class="messenger">
  <div
    class="messenger__inner {{#if activeChannel}}channel-is-active{{/if}}"
    data-js-messenger
  >
    <aside class="messenger__aside">
      <header class="messenger__header static-header">
        <button
          class="messenger__burger-button"
          type="button"
          aria-label="Меню"
          title="Меню"
          data-js-messenger-burger-button
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 6.001h18m-18 6h18m-18 6h18"
            />
          </svg>
        </button>
        <input type="search" name="search" class="messenger__header-search" />
      </header>
      <div class="messenger__channels">
        <nav class="channels" data-js-channels>
          <ul class="channels__list">
            {{#each channels}}
            <li class="channels__item">
              <div class="channel-card {{#if isActive}}isActive{{/if}}">
                <a
                  href="{{link}}"
                  data-channel-id="{{id}}"
                  class="channel-card__link"
                  data-js-channel-card-link
                >
                  <div class="channel-card__container">
                    <img class="avatar" src="{{avatar}}" alt="Аватар чата" />
                    <div class="channel-card__content">
                      <div class="channel-card__header">
                        <div class="channel-card__user">{{username}}</div>
                        <div class="channel-card__date">{{date}}</div>
                      </div>
                      <div class="channel-card__body">
                        <div class="channel-card__last-message">
                          {{last_message}}
                        </div>
                        {{#if new_messages}}
                        <div class="channel-card__new-messages colored-border">
                          <span class="channel-card__new-messages-count"
                            >{{new_messages}}</span
                          >
                        </div>
                        {{/if}}
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            </li>
            {{/each}}
          </ul>
        </nav>
      </div>
    </aside>
    <main class="messenger__main">
      <div class="channel">
        {{#if activeChannel}}
        <header class="channel__header static-header">
          <div class="channel__header-meta">
            <button
              type="button"
              class="channel__header-back"
              title="к списку чатов"
              aria-label="к списку чатов"
              channel-is-not-active
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
              >
                <path
                  fill="currentColor"
                  d="M11.354 6.646a.5.5 0 0 1 0 .708L7.207 11.5H18a.5.5 0 0 1 0 1H7.207l4.147 4.146a.5.5 0 0 1-.708.708l-5-5a.5.5 0 0 1 0-.708l5-5a.5.5 0 0 1 .708 0"
                />
              </svg>
            </button>
            <div class="channel__header-title">{{activeChannel.username}}</div>
          </div>
          <div class="channel__header-tools">
            <div class="channel__header-tools-control">
              <div class="channel__header-tools-control-inner">
                <h2>Управление чатом</h2>
                <button type="button" data-js-adduser-show-modal>
                  Пригласить в чат
                </button>
                <button type="button" data-js-removeuser-show-modal>
                  Удалить из чата
                </button>
              </div>
            </div>
            <button
              type="button"
              class="channel__header-tools-settings"
              aria-label="настройки чата"
              title="настройки чата"
              data-js-channel-settings
            >
              ...
            </button>
          </div>
        </header>
        <div class="channel__window">
          <div class="channel__window-wrapper" data-js-channel-messages>
            {{> messages}}
          </div>
        </div>
        <footer class="channel__footer">
          <div
            class="channel__footer-attached visually-hidden"
            js-data-channel-attached
          >
            <span
              class="channel__footer-attached-filename"
              js-data-channel-attached-filename
            ></span>
            <button
              type="button"
              class="channel__footer-attached-cancel icon"
              js-data-channel-attached-cancel
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
              >
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-miterlimit="10"
                  stroke-width="1.5"
                  d="m7.757 16.243l8.486-8.486m0 8.486L7.757 7.757"
                />
              </svg>
            </button>
          </div>
          <form action="" class="channel__footer-form">
            <input
              type="file"
              name="channel-attach"
              class="channel__footer-form-attach"
              id="channel-attach"
              accept="image/*"
              js-data-channel-form-attach
            />
            <label for="channel-attach">
              <div class="channel__footer-form-attach-icon icon">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 16 16"
                >
                  <path
                    fill="currentColor"
                    d="M2.283 7.975a.5.5 0 0 0 .854.354l4.595-4.597a2.5 2.5 0 1 1 3.536 3.536l-5.303 5.304a1 1 0 0 1-1.414-1.414l5.303-5.304a.5.5 0 0 0-.708-.708l-5.303 5.305a2 2 0 1 0 2.828 2.828l5.303-5.304a3.5 3.5 0 1 0-4.95-4.95L2.43 7.621a.5.5 0 0 0-.146.354"
                  />
                </svg></div
            ></label>
            <textarea
              name="message"
              class="channel__footer-form-input"
              placeholder="Ваше сообщение"
              data-js-channel-input
            ></textarea>
            <button
              class="channel__footer-form-send visually-hidden"
              type="button"
              data-js-channel-input-send
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 20 20"
              >
                <path
                  fill="currentColor"
                  d="M2.724 2.053a.5.5 0 0 0-.707.576l1.498 5.618a.5.5 0 0 0 .4.364l6.855 1.142c.279.047.279.447 0 .494l-6.854 1.142a.5.5 0 0 0-.401.364l-1.498 5.618a.5.5 0 0 0 .707.576l15-7.5a.5.5 0 0 0 0-.894z"
                />
              </svg>
            </button>
          </form>
        </footer>
        {{else}}
        <div class="channel__no-active">
          <p>Выберите чат, чтобы начать общаться</p>
        </div>
        {{/if}}
      </div>
    </main>
  </div>
</div>
