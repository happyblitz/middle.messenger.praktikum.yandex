{{#if activeChannel}}
<div class="absolute-box popup" data-js-modal data-js-adduser>
  {{> modal_close_btn}}
  <div class="popup__adduser">
    <h3 class="popup__title">Добавить пользователя</h3>
    <form action="" class="popup__form">
      <input type="text" class="popup__input" />
      <button class="popup__button" type="button">Добавить</button>
    </form>
  </div>
</div>
<div class="absolute-box popup" data-js-modal data-js-removeuser>
  {{> modal_close_btn}}
  <div class="popup__removeuser">
    <h3 class="popup__title">Удалить пользователя</h3>
    <form action="" class="popup__form">
      <input type="text" class="popup__input" />
      <button class="popup__button" type="button">Удалить</button>
    </form>
  </div>
</div>
{{/if}}
