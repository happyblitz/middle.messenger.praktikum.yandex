<div class="fixed-box modal-closed" data-js-profile-password-modal>
  <div class="profile">
    <div class="profile__main">
      <div class="profile__header">{{> profile__header}}</div>
      <form class="contents" action="">
        <div class="profile__data clear-input">
          <label class="profile__data-container">
            <span class="profile__data-term">Текущий пароль</span>
            <input
              type="password"
              name="old_password"
              value="my pass"
              class="profile__data-value"
            />
          </label>
          <label class="profile__data-container">
            <span class="profile__data-term">Новый пароль</span>
            <input
              type="password"
              name="new_password"
              value="new password"
              class="profile__data-value"
            />
          </label>
          <label class="profile__data-container">
            <span class="profile__data-term">Повторите новый пароль</span>
            <input
              type="password"
              name="new_password_confirm"
              value="new password"
              class="profile__data-value"
            />
          </label>
        </div>
        <div class="profile__controls">
          <button
            type="button"
            class="profile__controls-edit"
            href=""
            data-js-modal-close-self
          >
            Сохранить
          </button>
        </div>
      </form>
    </div>
    {{> profile__footer}}
  </div>
</div>
