<div class="channel">
  {{#if id}}
  <header class="channel__header static-header">
    <div class="channel__header-meta">
      {{{backButton}}}
      <div class="channel__header-title">{{username}}</div>
    </div>
    <div class="channel__header-tools">
      <div class="channel__header-tools-control">
        <div class="channel__header-tools-control-inner">
          <h2>Управление чатом</h2>
          {{{addToChatButton}}} {{{removeFromChatButton}}}
        </div>
      </div>
      {{{settingsButton}}}
    </div>
  </header>
  <div class="channel__window" ref="messages-container">
    <div class="channel__window-wrapper" ref="messages"></div>
  </div>
  <footer class="channel__footer">
    {{{showAttach}}}
    <form action="" class="channel__footer-form" ref="form">
      {{{attachInput}}}
      <label for="{{attachFieldName}}">
        <div
          class="channel__footer-form-attach-icon icon"
          title="прикрепить файл"
          aria-label="прикрепить файл"
        >
          {{{attachIcon}}}
        </div></label
      >
      {{{areaInput}}} {{{submitButton}}}
    </form>
  </footer>
  <div class="absolute-box popup" ref="addUserModal" data-js-modal>
    {{{modalCloseButton_1}}}
    <div class="popup__adduser">
      <h3 class="popup__title">Добавить пользователя</h3>
      <form action="" class="popup__form">
        {{{addUserInput}}} {{{addUserButton}}}
      </form>
    </div>
  </div>
  <div class="absolute-box popup" ref="removeUserModal" data-js-modal>
    {{{modalCloseButton_2}}}
    <div class="popup__removeuser">
      <h3 class="popup__title">Удалить пользователя</h3>
      <form action="" class="popup__form">
        {{{removeUserInput}}} {{{removeUserButton}}}
      </form>
    </div>
  </div>
  {{else}}
  <div class="channel__no-active">
    <p>Выберите чат, чтобы начать общаться</p>
  </div>
  {{/if}}
</div>
