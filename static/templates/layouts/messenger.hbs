<div class="messenger">
  <div class="messenger__inner">
    <aside class="messenger__aside">
      <header class="messenger__header static-header">
        <button
          class="messenger__burger-button"
          type="button"
          aria-label="Меню"
          title="Меню"
          data-js-messenger-burger-button
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 6.001h18m-18 6h18m-18 6h18"
            />
          </svg>
        </button>
        <input type="search" name="search" class="messenger__header-search" />
      </header>
      <div class="messenger__channels">{{> messenger__channels_list}}</div>
    </aside>
    <main class="messenger__main">{{> messenger__channel}}</main>
  </div>
</div>
{{> channel_controls}}{{> profile}}{{> profile__edit}}{{> profile__password}}
